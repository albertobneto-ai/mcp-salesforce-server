{
  "specName": "Leads_SalesEngagement",
  "version": "1.0",
  "description": "Modelo de dados e regras para workstream de Leads & Sales Engagement - CRM B2B Algar Telecom",
  "metadata": {
    "customObjects": [
      {
        "fullName": "Neoway_Prospect__c",
        "label": "Prospect Neoway",
        "pluralLabel": "Prospects Neoway",
        "deploymentStatus": "Deployed",
        "sharingModel": "ReadWrite",
        "nameField": {
          "fullName": "Name",
          "label": "Nome do Prospect",
          "type": "Text"
        },
        "fields": [
          {
            "fullName": "CNPJ__c",
            "label": "CNPJ",
            "type": "Text",
            "length": 18,
            "required": true,
            "externalId": true
          },
          {
            "fullName": "Razao_Social__c",
            "label": "Razão Social",
            "type": "Text",
            "length": 255,
            "required": true
          },
          {
            "fullName": "Segmento__c",
            "label": "Segmento",
            "type": "Picklist",
            "picklist": ["Enterprise", "Mid-Market", "SMB"]
          },
          {
            "fullName": "Score_Neoway__c",
            "label": "Score Neoway",
            "type": "Number",
            "precision": 5,
            "scale": 2
          },
          {
            "fullName": "Data_Ultima_Atualizacao__c",
            "label": "Data Última Atualização",
            "type": "DateTime"
          },
          {
            "fullName": "Status_Prospeccao__c",
            "label": "Status Prospecção",
            "type": "Picklist",
            "picklist": ["Novo", "Em Análise", "Qualificado", "Descartado", "Convertido"]
          }
        ]
      }
    ],
    "customFields": [
      {
        "fullName": "Lead.Prioridade_Tecnica__c",
        "label": "Prioridade Técnica",
        "type": "Text",
        "length": 50,
        "description": "Prioridade calculada com base no score Neoway e segmento"
      },
      {
        "fullName": "Lead.Canal_Origem__c",
        "label": "Canal de Origem",
        "type": "Picklist",
        "picklist": ["Neoway", "WhatsApp", "Website", "Indicação", "Evento", "Outbound"]
      },
      {
        "fullName": "Lead.CNPJ__c",
        "label": "CNPJ",
        "type": "Text",
        "length": 18,
        "externalId": true
      },
      {
        "fullName": "Lead.Score_Engajamento__c",
        "label": "Score de Engajamento",
        "type": "Number",
        "precision": 5,
        "scale": 0,
        "description": "Score calculado pelo Sales Engagement baseado em interações"
      }
    ],
    "validationRules": [
      {
        "fullName": "Lead.CNPJ_Formato_Valido",
        "active": true,
        "errorConditionFormula": "AND(NOT(ISBLANK(CNPJ__c)), NOT(REGEX(CNPJ__c, '[0-9]{2}\\\\.?[0-9]{3}\\\\.?[0-9]{3}\\\\/?[0-9]{4}\\\\-?[0-9]{2}')))",
        "errorMessage": "CNPJ deve estar no formato válido (XX.XXX.XXX/XXXX-XX ou somente números)",
        "errorDisplayField": "CNPJ__c"
      }
    ],
    "recordTypes": [
      {
        "fullName": "Lead.B2B_Enterprise",
        "label": "B2B Enterprise",
        "active": true,
        "description": "Leads do segmento Enterprise"
      },
      {
        "fullName": "Lead.B2B_MidMarket",
        "label": "B2B Mid-Market",
        "active": true,
        "description": "Leads do segmento Mid-Market"
      }
    ]
  }
}
